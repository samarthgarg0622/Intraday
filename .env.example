# .env.example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub — it contains secrets.
# On Railway: add these as Environment Variables in the dashboard.
# ─────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────
# Step 1: Open Telegram, search for @BotFather
# Step 2: Send /newbot, follow prompts, copy the token below
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Step 3: Search for @userinfobot on Telegram
# Step 4: Send any message to it — it replies with your Chat ID
TELEGRAM_CHAT_ID=your_numeric_chat_id_here
